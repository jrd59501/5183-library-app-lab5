{
  "rules": [
    {
      "enabled": true,
      "name": "movetocool",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "tierToCool": {
              "daysAfterModificationGreaterThan": 30
            }
          }
        },
        "filters": {
          "blobTypes": [
            "blockBlob"
          ],
          "prefixMatch": [
            "https://stgch01jrd.blob.core.windows.net/logs-jrd"
          ]
        }
      }
    }
  ]
}